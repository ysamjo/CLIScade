{
  "name": "cliscade",
  "version": "1.0.0",
  "description": "Lokaler Orchestrator für KI-Coding-Harnesses mit Fallback-Kaskade und Projektgedächtnis",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:routing && node test/ui-smoke.mjs",
    "test:routing": "node --test \"test/*.test.js\" \"test/runtime/*.test.js\"",
    "build:mac": "zsh mac-app/build.sh",
    "open:mac": "open \"build/CLIScade.app\"",
    "install:mac": "zsh mac-app/build.sh --install"
  },
  "keywords": [
    "harness",
    "agentic-coding",
    "claude",
    "codex",
    "antigravity",
    "router",
    "consensus"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "express": "^5.2.1",
    "js-yaml": "^5.4.2",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ysamjo/CLIScade.git"
  }
}
